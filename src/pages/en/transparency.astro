---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TransparencyContent from '../../components/TransparencyContent.tsx';
import { t } from '../../i18n/strings';

const projects = await getCollection('projects');
const projectData = projects.map(p => p.data);
const documents = (await getCollection('circulars')).map(c => ({ ...c.data, source: c.id }));

const lang = 'en' as const;
const basePath = `${import.meta.env.BASE_URL}${lang}`.replace(/\/$/, '');
---

<BaseLayout
  title={`${t(lang, 'trans_title')} — ${t(lang, 'brand_title')}`}
  description={t(lang, 'trans_desc')}
  lang={lang}
  currentPage="transparency"
>
  <TransparencyContent projects={projectData} documents={documents} lang={lang} basePath={basePath} client:load />
</BaseLayout>
