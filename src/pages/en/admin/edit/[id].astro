---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ProjectEditor from '../../../../components/ProjectEditor.tsx';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { id: p.data.id },
    props: { project: p.data },
  }));
}

const { project } = Astro.props;
const lang = 'en' as const;
const baseUrl = import.meta.env.BASE_URL;
const returnTo = `${baseUrl}${lang}/admin/`.replace(/\/+/g, '/');

function fixBilingual(b: any): { ar: string; en: string } {
  return { ar: b?.ar ?? '', en: b?.en ?? '' };
}
function fixList<T extends Record<string, any>>(items: any[] | undefined, fix: (item: any) => T): T[] {
  return (items ?? []).map(fix);
}

const initial = {
  ...project,
  title: fixBilingual(project.title),
  location: fixBilingual(project.location),
  description: fixBilingual(project.description),
  subs: fixList(project.subs, (s: any) => ({
    ...s,
    title: fixBilingual(s.title),
    length: fixBilingual(s.length),
  })),
  // Real dates (`at`) replace the old free-text dates.
  deadline: project.deadline ?? '',
  govFunding: {
    type: (project as any).govFunding?.type === 'full' || (project as any).govFunding?.type === 'partial' ? (project as any).govFunding.type : 'none',
    amountUSD: Number((project as any).govFunding?.amountUSD) > 0 ? Number((project as any).govFunding.amountUSD) : 0,
    note: fixBilingual((project as any).govFunding?.note ?? { ar: '', en: '' }),
  },
  updates: fixList(project.updates, (u: any) => ({
    at: u.at,
    author: fixBilingual(u.author),
    body: fixBilingual(u.body),
  })),
  engineers: fixList(project.engineers, (e: any) => ({
    name: fixBilingual(e.name),
    role: fixBilingual(e.role),
    phone: e.phone,
    userId: e.userId,
  })),
  comments: fixList(project.comments, (c: any) => ({
    author: fixBilingual(c.author),
    body: fixBilingual(c.body),
    at: c.at ?? c.date,
  })),
};
---

<BaseLayout
  title={`Edit — ${project.title.ar}`}
  description="Edit project"
  lang={lang}
  currentPage="admin"
>
  <ProjectEditor
    initial={initial}
    lang={lang}
    basePath={`${baseUrl}${lang}`.replace(/\/+/g, '/')}
    returnTo={returnTo}
    client:load
  />
</BaseLayout>
